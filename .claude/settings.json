{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "STUDIO_LIVE": "0"
  },
  "permissions": {
    "allow": [
      "Bash(python3 -m studio:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(npm publish:*)",
      "Bash(shopify:*)",
      "Bash(stripe:*)"
    ]
  }
}
